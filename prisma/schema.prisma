// ── Tareas periódicas (obligaciones operativas) ────────────────────────────

/// Estado de una obligación periódica.
/// PENDING_ASSIGNMENT → acaba de vencer, esperando asignación a una limpieza real.
/// ASSIGNED           → el host la asignó a una limpieza concreta.
/// COMPLETED          → resuelta (la limpieza asignada la ejecutó).
/// SKIPPED            → el host decidió omitirla explícitamente.
enum TaskRecurringDueStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  COMPLETED
  SKIPPED
}

/// Obligación operativa periódica — representa que una actividad ha vencido
/// y debe resolverse dentro de una limpieza real.
/// No es una ejecución; es una deuda. La ejecución sigue ocurriendo dentro
/// de una limpieza real a través de syncTaskJobsForCleaning.
///
/// Deduplicación: @@unique([tenantId, templateId, periodKey]) evita duplicados
/// del mismo período. Si existe una obligación abierta (PENDING_ASSIGNMENT o ASSIGNED)
/// para un template, el siguiente período no crea una nueva hasta que se resuelva.
model TaskRecurringDue {
  id                 String                 @id @default(cuid())
  tenantId           String
  propertyId         String
  templateId         String

  /// Frecuencia de la recurrencia: DAILY | WEEKLY | MONTHLY
  frequency          TaskScheduleFrequency

  /// Clave del período al que corresponde esta obligación.
  /// Template-level:  "daily:2024-04-10" | "weekly:2024-W15" | "monthly:2024-04"
  /// Step-level:      "step:{stepId}:weekly:2024-W15"  (stepId embebido para unicidad)
  periodKey          String

  /// Paso específico que originó esta obligación (solo para dues step-level).
  /// null = obligación a nivel de template completo.
  stepId             String?

  status             TaskRecurringDueStatus @default(PENDING_ASSIGNMENT)

  /// Limpieza a la que fue asignada (cuando status = ASSIGNED)
  assignedCleaningId String?

  assignedAt         DateTime?
  completedAt        DateTime?
  skippedAt          DateTime?
  skipReason         String?

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  template           TaskTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  property           Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedCleaning   Cleaning?              @relation(fields: [assignedCleaningId], references: [id], onDelete: SetNull)
  step               TaskStepTemplate?      @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@unique([tenantId, templateId, periodKey])
  @@index([tenantId, propertyId, status])
  @@index([tenantId, status])
  @@index([tenantId])
}
