/// Configuración de ejecutor preferido por propiedad y equipo.
/// El TL define qué miembro recibe automáticamente las limpiezas de una propiedad.
model PropertyAssignmentConfig {
  id                    String         @id @default(cuid())
  /// Tenant del Host (propietario de la propiedad)
  hostTenantId          String
  /// Tenant del equipo de servicios
  servicesTenantId      String
  propertyId            String
  teamId                String
  preferredMembershipId String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  property              Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  team                  Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  preferredMembership   TeamMembership @relation(fields: [preferredMembershipId], references: [id], onDelete: Cascade)

  @@unique([propertyId, teamId])
  @@index([hostTenantId])
  @@index([servicesTenantId])
  @@index([teamId])
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  PAUSED
}

enum HostWorkGroupStatus {
  ACTIVE
  INACTIVE
}

enum TeamRole {
  OWNER
  MANAGER
  AUXILIAR
  CLEANER
  HANDYMAN
